---
interface Props {
	count?: number;
}
const { count = 0 } = Astro.props;
---

<counter-button>
	<button @click="increment">
		Count is <x-signal>{count}</x-signal>
	</button>
</counter-button>

<script>
	import { component, signal } from "../../../../src/index.ts";
	const count = signal<number>("counter-button");
	function increment() {
		count.state = count.state + 1;
	}
	component('counter-button', [increment]);
</script>

<style>
	button {
		font-family: inherit;
		font-size: inherit;
		font-weight: inherit;
		color: black;
		background-color: #efefef;
		border: 2px solid #000;
		border-radius: 8px;
		padding: 6px 10px;
	}
	button:hover,
	button:active {
		cursor: pointer;
		background-color: #e6e6e6;
	}
</style>
